# Primjer postavki. Aplikacija čita varijable okruženja; ovu datoteku ne učitava
# sama, služi kao popis onoga što se može postaviti.

# --- obavezno u produkciji ---
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=racuni.example.com
DATABASE_URL=postgres://korisnik:lozinka@localhost:5432/racuni
FRONTEND_URL=https://racuni.example.com

# --- razvoj ---
# DJANGO_DEBUG=1 uključuje razvojni način (SQLite).
DJANGO_DEBUG=0
